<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="PadForge.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:PadForge.Controls"
    xmlns:vm="using:PadForge.ViewModels"
    Title="PadForge">
    <Grid x:Name="Root" Background="{StaticResource ForgeBackgroundBrush}" IsTabStop="True" KeyDown="Root_KeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBarDrag" Background="{StaticResource ForgeBackgroundBrush}" Padding="20,0,160,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Ellipse Width="10" Height="10" Fill="{StaticResource ForgeAccentBrush}" VerticalAlignment="Center" />
                <TextBlock Text="PadForge" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource ForgeTextBrush}" VerticalAlignment="Center" />
                <TextBlock Text="Keyboard and mouse, as a controller" Margin="8,0,0,0" FontSize="13" Foreground="{StaticResource ForgeMutedBrush}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
        <Border Grid.Row="0" Height="1" VerticalAlignment="Bottom" Background="{StaticResource ForgeCardBorderBrush}" />

        <ScrollViewer Grid.Row="1" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <Grid MaxWidth="1120" HorizontalAlignment="Center" Padding="28,20,28,32" RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <InfoBar
                    IsOpen="{x:Bind ViewModel.ShowBusWarning, Mode=OneWay}"
                    IsClosable="False"
                    Severity="Warning"
                    Title="ViGEmBus is not installed"
                    Message="PadForge needs the ViGEmBus driver before it can create a virtual Xbox 360 controller.">
                    <InfoBar.ActionButton>
                        <HyperlinkButton Content="Download ViGEmBus" NavigateUri="https://github.com/nefarius/ViGEmBus/releases" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                    <Border Padding="12,7" CornerRadius="999" Background="{StaticResource ForgeCardBrush}" BorderBrush="{StaticResource ForgeCardBorderBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse x:Name="BusDot" Width="8" Height="8" Fill="{StaticResource ForgeMutedBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.BusHeadline, Mode=OneWay}" Foreground="{StaticResource ForgeTextBrush}" FontSize="13" />
                        </StackPanel>
                    </Border>
                    <Border Padding="12,7" CornerRadius="999" Background="{StaticResource ForgeCardBrush}" BorderBrush="{StaticResource ForgeCardBorderBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse x:Name="LinkDot" Width="8" Height="8" Fill="{StaticResource ForgeMutedBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.LinkHeadline, Mode=OneWay}" Foreground="{StaticResource ForgeTextBrush}" FontSize="13" />
                        </StackPanel>
                    </Border>
                    <Border Padding="12,7" CornerRadius="999" Background="{StaticResource ForgeCardBrush}" BorderBrush="{StaticResource ForgeCardBorderBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse x:Name="OutputDot" Width="8" Height="8" Fill="{StaticResource ForgeMutedBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.OutputHeadline, Mode=OneWay}" Foreground="{StaticResource ForgeTextBrush}" FontSize="13" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Grid Grid.Row="2" ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*" MinWidth="420" />
                        <ColumnDefinition Width="*" MinWidth="360" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource ForgeCard}">
                        <StackPanel Spacing="18">
                            <TextBlock Text="LIVE VIEW" Style="{StaticResource SectionLabel}" />
                            <controls:ControllerPreview x:Name="Preview" />
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button
                                    Content="{x:Bind ViewModel.ActionLabel, Mode=OneWay}"
                                    IsEnabled="{x:Bind ViewModel.ActionEnabled, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.ToggleOutputCommand}"
                                    Style="{StaticResource ForgePrimaryButton}"
                                    AutomationProperties.Name="Connect or disconnect the virtual controller" />
                                <Button Content="Center stick" Command="{x:Bind ViewModel.CenterStickCommand}" AutomationProperties.Name="Center the right stick" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <TextBlock Text="Toggle" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{x:Bind ViewModel.HotkeyLabel, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource ForgeAccentBrush}" VerticalAlignment="Center" />
                                <Button Content="{x:Bind ViewModel.HotkeyCaptureLabel, Mode=OneWay}" Command="{x:Bind ViewModel.BeginHotkeyCaptureCommand}" MinWidth="108" AutomationProperties.Name="Change toggle hotkey" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource MutedBody}" Text="Output pauses while this window is in front, so you can change settings without driving the pad. The preview stays live. Alt-tab to a game to send input." />
                            <TextBlock Text="{x:Bind ViewModel.StatusDetail, Mode=OneWay}" Style="{StaticResource MutedBody}" />
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="1" Spacing="16">
                        <Border Style="{StaticResource ForgeCard}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="RIGHT STICK" Style="{StaticResource SectionLabel}" />
                                <Grid>
                                    <TextBlock Text="Sensitivity" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="{x:Bind ViewModel.SensitivityText, Mode=OneWay}" HorizontalAlignment="Right" Foreground="{StaticResource ForgeMutedBrush}" />
                                </Grid>
                                <Slider Minimum="0.2" Maximum="4" StepFrequency="0.05" Value="{x:Bind ViewModel.Sensitivity, Mode=TwoWay}" AutomationProperties.Name="Sensitivity" />
                                <Grid>
                                    <TextBlock Text="Curve" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="{x:Bind ViewModel.CurveText, Mode=OneWay}" HorizontalAlignment="Right" Foreground="{StaticResource ForgeMutedBrush}" />
                                </Grid>
                                <Slider Minimum="0.6" Maximum="3" StepFrequency="0.05" Value="{x:Bind ViewModel.Curve, Mode=TwoWay}" AutomationProperties.Name="Response curve" />
                                <Grid>
                                    <TextBlock Text="Deadzone" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="{x:Bind ViewModel.DeadzoneText, Mode=OneWay}" HorizontalAlignment="Right" Foreground="{StaticResource ForgeMutedBrush}" />
                                </Grid>
                                <Slider Minimum="0" Maximum="0.3" StepFrequency="0.01" Value="{x:Bind ViewModel.Deadzone, Mode=TwoWay}" AutomationProperties.Name="Deadzone" />
                                <ToggleSwitch Header="Spring back to center" IsOn="{x:Bind ViewModel.Spring, Mode=TwoWay}" AutomationProperties.Name="Spring back to center" />
                                <TextBlock Text="{x:Bind ViewModel.SpringHint, Mode=OneWay}" Style="{StaticResource MutedBody}" />
                                <Grid>
                                    <TextBlock Text="Return speed" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="{x:Bind ViewModel.SpringRateText, Mode=OneWay}" HorizontalAlignment="Right" Foreground="{StaticResource ForgeMutedBrush}" />
                                </Grid>
                                <Slider Minimum="4" Maximum="40" StepFrequency="1" Value="{x:Bind ViewModel.SpringRate, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.Spring, Mode=OneWay}" AutomationProperties.Name="Return speed" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ForgeCard}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="PROFILE" Style="{StaticResource SectionLabel}" />
                                <ComboBox
                                    ItemsSource="{x:Bind ViewModel.Profiles}"
                                    SelectedItem="{x:Bind ViewModel.SelectedProfile, Mode=TwoWay}"
                                    HorizontalAlignment="Stretch"
                                    PlaceholderText="Profiles"
                                    AutomationProperties.Name="Saved profiles" />
                                <TextBox
                                    Text="{x:Bind ViewModel.ProfileName, Mode=TwoWay}"
                                    PlaceholderText="Profile name"
                                    AutomationProperties.Name="Profile name" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Save" Command="{x:Bind ViewModel.SaveProfileCommand}" Style="{StaticResource ForgePrimaryButton}" />
                                    <Button Content="Reload" Command="{x:Bind ViewModel.ReloadProfileCommand}" />
                                </StackPanel>
                                <TextBlock Text="Profiles are stored in Local AppData\PadForge\profiles." Style="{StaticResource MutedBody}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ForgeCard}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="BINDINGS" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
                                <TextBlock Text="Backspace clears a binding. Escape cancels." Style="{StaticResource MutedBody}" Margin="0,0,0,8" />
                                <ItemsControl ItemsSource="{x:Bind ViewModel.Bindings}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:BindingRow">
                                            <StackPanel Margin="0,0,0,6">
                                                <TextBlock Text="{x:Bind Group}" Style="{StaticResource SectionLabel}" Margin="0,12,0,6" Visibility="{x:Bind GroupVisibility}" />
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="140" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{x:Bind Label}" Style="{StaticResource FieldLabel}" />
                                                    <TextBlock Grid.Column="1" Text="{x:Bind KeyLabel, Mode=OneWay}" Foreground="{StaticResource ForgeMutedBrush}" VerticalAlignment="Center" />
                                                    <Button Grid.Column="2" MinWidth="108" Content="{x:Bind CaptureLabel, Mode=OneWay}" Command="{x:Bind CaptureCommand}" AutomationProperties.Name="{x:Bind Label}" />
                                                </Grid>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
