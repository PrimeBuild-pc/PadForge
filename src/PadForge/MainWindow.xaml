<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="PadForge.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="PadForge">
    <Grid x:Name="Root" Background="{StaticResource ForgeBackgroundBrush}" IsTabStop="True" KeyDown="Root_KeyDown" PointerWheelChanged="Root_PointerWheelChanged">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Grid Background="{StaticResource ForgeSidebarBrush}" BorderBrush="{StaticResource ForgeCardBorderBrush}" BorderThickness="0,0,1,0" Padding="12,0,12,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="11" Margin="8,22,0,22">
                <Grid Width="34" Height="34">
                    <Border CornerRadius="9" Background="{StaticResource ForgeEmberBrush}" />
                    <FontIcon Glyph="&#xE7FC;" FontSize="18" Foreground="{StaticResource ForgeAccentDeepBrush}" />
                </Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="PadForge" FontFamily="{StaticResource ForgeDisplayFont}" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource ForgeTextBrush}" />
                    <TextBlock Text="Free · open source" FontSize="11" Foreground="{StaticResource ForgeSubtleBrush}" />
                </StackPanel>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="2">
                    <RadioButton x:Name="NavOverview" Style="{StaticResource NavItem}" Tag="overview" Checked="Nav_Checked" IsChecked="True" AutomationProperties.Name="Overview">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE80F;" FontSize="15" />
                            <TextBlock Text="Overview" FontSize="14" />
                        </StackPanel>
                    </RadioButton>

                    <TextBlock Text="SETUP" Style="{StaticResource SectionLabel}" Margin="12,18,0,6" />
                    <RadioButton Style="{StaticResource NavItem}" Tag="controller" Checked="Nav_Checked" AutomationProperties.Name="Controller">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE7FC;" FontSize="15" />
                            <TextBlock Text="Controller" FontSize="14" />
                        </StackPanel>
                    </RadioButton>

                    <TextBlock Text="PLAY" Style="{StaticResource SectionLabel}" Margin="12,18,0,6" />
                    <RadioButton Style="{StaticResource NavItem}" Tag="aim" Checked="Nav_Checked" AutomationProperties.Name="Aim and sticks">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE962;" FontSize="15" />
                            <TextBlock Text="Aim &amp; sticks" FontSize="14" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavItem}" Tag="mapping" Checked="Nav_Checked" AutomationProperties.Name="Mapping">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE765;" FontSize="15" />
                            <TextBlock Text="Mapping" FontSize="14" />
                        </StackPanel>
                    </RadioButton>

                    <TextBlock Text="LIBRARY" Style="{StaticResource SectionLabel}" Margin="12,18,0,6" />
                    <RadioButton Style="{StaticResource NavItem}" Tag="profiles" Checked="Nav_Checked" AutomationProperties.Name="Profiles">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE8F1;" FontSize="15" />
                            <TextBlock Text="Profiles" FontSize="14" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavItem}" Tag="settings" Checked="Nav_Checked" AutomationProperties.Name="Settings">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE713;" FontSize="15" />
                            <TextBlock Text="Settings &amp; about" FontSize="14" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </ScrollViewer>

            <!-- Always-visible state and profile switch -->
            <Border Grid.Row="2" Style="{StaticResource ForgeCard}" Padding="14" CornerRadius="10">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <Ellipse x:Name="SideDot" Width="9" Height="9" Fill="{StaticResource ForgeSubtleBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.LinkHeadline, Mode=OneWay}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource ForgeTextBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.OutputHeadline, Mode=OneWay}" FontSize="13" Foreground="{StaticResource ForgeMutedBrush}" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.PadKindName, Mode=OneWay}" FontSize="12" Foreground="{StaticResource ForgeSubtleBrush}" Margin="18,-6,0,0" />
                    <Button Content="{x:Bind ViewModel.ActionLabel, Mode=OneWay}"
                            IsEnabled="{x:Bind ViewModel.ActionEnabled, Mode=OneWay}"
                            Command="{x:Bind ViewModel.ToggleOutputCommand}"
                            Style="{StaticResource ForgePrimaryButton}"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.Name="Connect or disconnect the virtual controller" />
                    <TextBlock FontSize="12" Foreground="{StaticResource ForgeSubtleBrush}" HorizontalAlignment="Center">
                        <Run Text="Toggle anywhere with" />
                        <Run Text="{x:Bind ViewModel.HotkeyLabel, Mode=OneWay}" Foreground="{StaticResource ForgeAccentBrush}" FontWeight="SemiBold" />
                    </TextBlock>
                    <ComboBox ItemsSource="{x:Bind ViewModel.Profiles}"
                              SelectedItem="{x:Bind ViewModel.SelectedProfile, Mode=TwoWay}"
                              HorizontalAlignment="Stretch"
                              Header="Profile"
                              AutomationProperties.Name="Active profile" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Content -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid x:Name="TitleBarDrag" Background="Transparent" />
            <Grid x:Name="PageHost" Grid.Row="1" />

            <!-- Status line -->
            <Border Grid.Row="2" BorderBrush="{StaticResource ForgeCardBorderBrush}" BorderThickness="0,1,0,0" Padding="36,9">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE946;" FontSize="13" Foreground="{StaticResource ForgeSubtleBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.StatusDetail, Mode=OneWay}" FontSize="12" Foreground="{StaticResource ForgeMutedBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="18">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Ellipse x:Name="BusDot" Width="7" Height="7" Fill="{StaticResource ForgeSubtleBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.BusHeadline, Mode=OneWay}" FontSize="12" Foreground="{StaticResource ForgeMutedBrush}" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.Version}" FontSize="12" Foreground="{StaticResource ForgeSubtleBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
