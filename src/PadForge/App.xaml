<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="PadForge.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="SystemAccentColorLight3">#FFF6D7B8</Color>
                    <Color x:Key="SystemAccentColorLight2">#FFEEB98A</Color>
                    <Color x:Key="SystemAccentColorLight1">#FFE7A15F</Color>
                    <Color x:Key="SystemAccentColor">#FFE08A45</Color>
                    <Color x:Key="SystemAccentColorDark1">#FFC67538</Color>
                    <Color x:Key="SystemAccentColorDark2">#FFA85E2C</Color>
                    <Color x:Key="SystemAccentColorDark3">#FF8A4E24</Color>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <SolidColorBrush x:Key="ForgeBackgroundBrush" Color="#FF101216" />
            <SolidColorBrush x:Key="ForgeCardBrush" Color="#FF1A1E26" />
            <SolidColorBrush x:Key="ForgeCardBorderBrush" Color="#FF323846" />
            <SolidColorBrush x:Key="ForgeTextBrush" Color="#FFF3F5F8" />
            <SolidColorBrush x:Key="ForgeMutedBrush" Color="#FFA7B0C0" />
            <SolidColorBrush x:Key="ForgeAccentBrush" Color="#FFE08A45" />
            <SolidColorBrush x:Key="ForgeAccentDeepBrush" Color="#FF1C140E" />
            <SolidColorBrush x:Key="ForgeGoodBrush" Color="#FF3DDC97" />
            <SolidColorBrush x:Key="ForgeWarnBrush" Color="#FFE7C15A" />
            <SolidColorBrush x:Key="ForgeBadBrush" Color="#FFFF6B6B" />
            <SolidColorBrush x:Key="ForgeWellBrush" Color="#FF12151C" />
            <SolidColorBrush x:Key="ForgeButtonBrush" Color="#FF2A3140" />
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FFE08A45" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#FFC67538" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#FFA85E2C" />
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FF1C140E" />

            <Style x:Key="SectionLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="120" />
                <Setter Property="Foreground" Value="{StaticResource ForgeMutedBrush}" />
            </Style>
            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="{StaticResource ForgeTextBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="MutedBody" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{StaticResource ForgeMutedBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="ForgeCard" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource ForgeCardBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource ForgeCardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Padding" Value="20" />
            </Style>
            <Style x:Key="ForgePrimaryButton" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource ForgeAccentBrush}" />
                <Setter Property="Foreground" Value="{StaticResource ForgeAccentDeepBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="18,10" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="RootGrid"
                                  Background="{TemplateBinding Background}"
                                  CornerRadius="{TemplateBinding CornerRadius}"
                                  Padding="{TemplateBinding Padding}">
                                <ContentPresenter
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Content="{TemplateBinding Content}" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="RootGrid.Background" Value="#FFC67538" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="RootGrid.Background" Value="#FFA85E2C" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="RootGrid.Opacity" Value="0.45" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
