<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="PadForge.Controls.ResponseCurve"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="150"
    Height="150">
    <Grid>
        <Border
            Background="{StaticResource ForgeWellBrush}"
            BorderBrush="{StaticResource ForgeCardBorderBrush}"
            BorderThickness="1"
            CornerRadius="10" />
        <Canvas x:Name="PlotCanvas" Margin="12">
            <Polyline x:Name="Guide" Stroke="{StaticResource ForgeCardBorderBrush}" StrokeThickness="1" StrokeDashArray="3,3" />
            <Polyline x:Name="Trace" Stroke="{StaticResource ForgeAccentBrush}" StrokeThickness="2" />
            <Ellipse x:Name="Marker" Width="9" Height="9" Fill="{StaticResource ForgeTextBrush}" Visibility="Collapsed" />
        </Canvas>
        <TextBlock Text="in → out" FontSize="10" Foreground="{StaticResource ForgeSubtleBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,4" />
    </Grid>
</UserControl>
