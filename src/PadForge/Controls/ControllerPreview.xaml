<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="PadForge.Controls.ControllerPreview"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Top">
    <UserControl.Resources>
        <Style x:Key="PadKey" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource ForgeButtonBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ForgeCardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
    </UserControl.Resources>
    <Grid RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="6">
                <TextBlock Text="LT" Style="{StaticResource SectionLabel}" />
                <Grid x:Name="LtTrack" Height="10" CornerRadius="5" Background="{StaticResource ForgeWellBrush}">
                    <Border x:Name="LtFill" HorizontalAlignment="Left" Width="0" CornerRadius="5" Background="{StaticResource ForgeAccentBrush}" />
                </Grid>
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="6">
                <TextBlock Text="RT" Style="{StaticResource SectionLabel}" />
                <Grid x:Name="RtTrack" Height="10" CornerRadius="5" Background="{StaticResource ForgeWellBrush}">
                    <Border x:Name="RtFill" HorizontalAlignment="Left" Width="0" CornerRadius="5" Background="{StaticResource ForgeAccentBrush}" />
                </Grid>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Width="92" Height="92" HorizontalAlignment="Center" ColumnSpacing="6" RowSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border x:Name="PadUp" Grid.Column="1" Style="{StaticResource PadKey}" />
                <Border x:Name="PadLeft" Grid.Row="1" Style="{StaticResource PadKey}" />
                <Border x:Name="PadRight" Grid.Row="1" Grid.Column="2" Style="{StaticResource PadKey}" />
                <Border x:Name="PadDown" Grid.Row="2" Grid.Column="1" Style="{StaticResource PadKey}" />
            </Grid>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Border x:Name="BackButton" MinWidth="64" Height="28" CornerRadius="14" Padding="10,0" Background="{StaticResource ForgeButtonBrush}" BorderBrush="{StaticResource ForgeCardBorderBrush}" BorderThickness="1">
                    <TextBlock x:Name="BackLabel" Text="Back" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource ForgeMutedBrush}" />
                </Border>
                <Border x:Name="StartButton" MinWidth="64" Height="28" CornerRadius="14" Padding="10,0" Background="{StaticResource ForgeButtonBrush}" BorderBrush="{StaticResource ForgeCardBorderBrush}" BorderThickness="1">
                    <TextBlock x:Name="StartLabel" Text="Start" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource ForgeMutedBrush}" />
                </Border>
            </StackPanel>

            <Grid Width="112" Height="112" HorizontalAlignment="Center" Grid.Column="2">
                <Border x:Name="YButton" Width="36" Height="36" CornerRadius="18" HorizontalAlignment="Center" VerticalAlignment="Top" Background="{StaticResource ForgeButtonBrush}" BorderBrush="{StaticResource ForgeCardBorderBrush}" BorderThickness="1">
                    <TextBlock x:Name="YLabel" Text="Y" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource ForgeTextBrush}" />
                </Border>
                <Border x:Name="XButton" Width="36" Height="36" CornerRadius="18" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{StaticResource ForgeButtonBrush}" BorderBrush="{StaticResource ForgeCardBorderBrush}" BorderThickness="1">
                    <TextBlock x:Name="XLabel" Text="X" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource ForgeTextBrush}" />
                </Border>
                <Border x:Name="BButton" Width="36" Height="36" CornerRadius="18" HorizontalAlignment="Right" VerticalAlignment="Center" Background="{StaticResource ForgeButtonBrush}" BorderBrush="{StaticResource ForgeCardBorderBrush}" BorderThickness="1">
                    <TextBlock x:Name="BLabel" Text="B" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource ForgeTextBrush}" />
                </Border>
                <Border x:Name="AButton" Width="36" Height="36" CornerRadius="18" HorizontalAlignment="Center" VerticalAlignment="Bottom" Background="{StaticResource ForgeButtonBrush}" BorderBrush="{StaticResource ForgeCardBorderBrush}" BorderThickness="1">
                    <TextBlock x:Name="ALabel" Text="A" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource ForgeTextBrush}" />
                </Border>
            </Grid>
        </Grid>

        <Grid Grid.Row="2" ColumnSpacing="28">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="8">
                <Border x:Name="LbButton" Height="28" CornerRadius="8" Background="{StaticResource ForgeButtonBrush}" BorderBrush="{StaticResource ForgeCardBorderBrush}" BorderThickness="1">
                    <TextBlock x:Name="LbLabel" Text="LB" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource ForgeMutedBrush}" />
                </Border>
                <Grid Width="148" Height="148" HorizontalAlignment="Center">
                    <Ellipse Fill="{StaticResource ForgeWellBrush}" Stroke="{StaticResource ForgeCardBorderBrush}" StrokeThickness="2" />
                    <Ellipse Width="4" Height="4" Fill="{StaticResource ForgeMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Ellipse x:Name="LeftClickRing" Width="34" Height="34" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="{StaticResource ForgeCardBorderBrush}" StrokeThickness="2" />
                    <Ellipse Width="22" Height="22" Fill="{StaticResource ForgeAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse.RenderTransform>
                            <TranslateTransform x:Name="LeftShift" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                </Grid>
                <TextBlock Text="LEFT STICK" Style="{StaticResource SectionLabel}" HorizontalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="8">
                <Border x:Name="RbButton" Height="28" CornerRadius="8" Background="{StaticResource ForgeButtonBrush}" BorderBrush="{StaticResource ForgeCardBorderBrush}" BorderThickness="1">
                    <TextBlock x:Name="RbLabel" Text="RB" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource ForgeMutedBrush}" />
                </Border>
                <Grid Width="148" Height="148" HorizontalAlignment="Center">
                    <Ellipse Fill="{StaticResource ForgeWellBrush}" Stroke="{StaticResource ForgeCardBorderBrush}" StrokeThickness="2" />
                    <Ellipse Width="4" Height="4" Fill="{StaticResource ForgeMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Ellipse x:Name="RightClickRing" Width="34" Height="34" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="{StaticResource ForgeCardBorderBrush}" StrokeThickness="2" />
                    <Ellipse Width="22" Height="22" Fill="{StaticResource ForgeAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse.RenderTransform>
                            <TranslateTransform x:Name="RightShift" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                </Grid>
                <TextBlock Text="RIGHT STICK" Style="{StaticResource SectionLabel}" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <TextBlock x:Name="Readout"
                   Grid.Row="3"
                   HorizontalAlignment="Center"
                   FontFamily="Cascadia Mono, Consolas"
                   FontSize="13"
                   Foreground="{StaticResource ForgeMutedBrush}"
                   Text="L  0.00  0.00      R  0.00  0.00" />
    </Grid>
</UserControl>
