<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="PadForge.Views.ProfilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1120" Padding="36,4,36,32" Spacing="18">
            <StackPanel Spacing="4">
                <TextBlock Text="Profiles" Style="{StaticResource PageTitle}" />
                <TextBlock Text="One profile per game: bindings, aim tuning, toggle key and input hiding. PadForge reopens the last one you used." Style="{StaticResource PageSubtitle}" />
            </StackPanel>

            <Grid ColumnSpacing="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource ForgeCard}" Padding="10" VerticalAlignment="Top">
                    <StackPanel Spacing="8">
                        <ListView ItemsSource="{x:Bind ViewModel.Profiles}"
                                  SelectedItem="{x:Bind ViewModel.SelectedProfile, Mode=TwoWay}"
                                  SelectionMode="Single"
                                  MaxHeight="420"
                                  AutomationProperties.Name="Saved profiles">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <StackPanel Orientation="Horizontal" Spacing="10" Padding="0,8">
                                        <FontIcon Glyph="&#xE7FC;" FontSize="14" Foreground="{StaticResource ForgeMutedBrush}" />
                                        <TextBlock Text="{x:Bind}" FontSize="14" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <Grid ColumnSpacing="8" Margin="6,0,6,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Content="New" Command="{x:Bind ViewModel.NewProfileCommand}" Style="{StaticResource ForgeSecondaryButton}" HorizontalAlignment="Stretch" />
                            <Button Grid.Column="1" Content="Duplicate" Command="{x:Bind ViewModel.DuplicateProfileCommand}" Style="{StaticResource ForgeSecondaryButton}" HorizontalAlignment="Stretch" />
                        </Grid>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="1" Spacing="18">
                    <Border Style="{StaticResource ForgeCard}">
                        <StackPanel Spacing="14">
                            <Grid>
                                <TextBlock Text="Active profile" Style="{StaticResource CardTitle}" />
                                <Border x:Name="DirtyChip" HorizontalAlignment="Right" CornerRadius="999" Padding="10,3" Background="{StaticResource ForgeAccentSoftBrush}" Visibility="Collapsed">
                                    <TextBlock Text="Unsaved changes" FontSize="12" Foreground="{StaticResource ForgeAccentBrush}" />
                                </Border>
                            </Grid>
                            <TextBox Header="Name" Text="{x:Bind ViewModel.ProfileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Profile name" MaxLength="40" AutomationProperties.Name="Profile name" />
                            <TextBlock Style="{StaticResource MutedBody}" Text="Saving under a new name keeps the old profile. Letters, numbers, spaces, dashes and underscores only." />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Save" Command="{x:Bind ViewModel.SaveProfileCommand}" Style="{StaticResource ForgePrimaryButton}" />
                                <Button Content="Revert" Command="{x:Bind ViewModel.ReloadProfileCommand}" Style="{StaticResource ForgeSecondaryButton}" />
                                <Button Content="Delete" Click="Delete_Click" Style="{StaticResource ForgeSecondaryButton}" Foreground="{StaticResource ForgeBadBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource ForgeCard}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Profile files" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="{x:Bind ViewModel.ProfilesFolder}" Style="{StaticResource MutedBody}" FontFamily="{StaticResource ForgeMonoFont}" IsTextSelectionEnabled="True" />
                                <TextBlock Text="Profiles are plain JSON. Copy one to share a setup or back it up." Style="{StaticResource MutedBody}" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Open folder" Command="{x:Bind ViewModel.OpenProfilesFolderCommand}" Style="{StaticResource ForgeSecondaryButton}" VerticalAlignment="Top" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
