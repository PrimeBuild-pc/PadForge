<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="PadForge.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1120" Padding="36,4,36,32" Spacing="18">
            <StackPanel Spacing="4">
                <TextBlock Text="Settings &amp; about" Style="{StaticResource PageTitle}" />
                <TextBlock Text="These settings are stored in the active profile." Style="{StaticResource PageSubtitle}" />
            </StackPanel>

            <Border Style="{StaticResource ForgeCard}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Toggle hotkey" Style="{StaticResource CardTitle}" />
                        <TextBlock Style="{StaticResource MutedBody}" Text="Connects or disconnects the virtual controller from any window, including a game in full screen." />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Border CornerRadius="6" Padding="10,5" Background="{StaticResource ForgeRaisedBrush}" BorderBrush="{StaticResource ForgeCardBorderBrush}" BorderThickness="1">
                            <TextBlock Text="{x:Bind ViewModel.HotkeyLabel, Mode=OneWay}" FontFamily="{StaticResource ForgeMonoFont}" Foreground="{StaticResource ForgeAccentBrush}" />
                        </Border>
                        <Button Content="{x:Bind ViewModel.HotkeyCaptureLabel, Mode=OneWay}" Command="{x:Bind ViewModel.BeginHotkeyCaptureCommand}" Style="{StaticResource ForgeSecondaryButton}" MinWidth="108" AutomationProperties.Name="Change toggle hotkey" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource ForgeCard}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="6">
                        <TextBlock Text="Hide keys and clicks from the game" Style="{StaticResource CardTitle}" />
                        <TextBlock Style="{StaticResource MutedBody}" Text="While the controller is sending, mapped keys and mouse buttons are kept from Windows and the cursor is frozen. Many games then stop switching back to keyboard prompts, which is what keeps controller aim assist on." />
                        <TextBlock Style="{StaticResource MutedBody}" Foreground="{StaticResource ForgeWarnBrush}" Text="Limit: games that read the mouse through Raw Input still see mouse motion. Hiding that needs a separate filter driver, which PadForge does not install." />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.HideInput, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Top" AutomationProperties.Name="Hide mapped keys and clicks from the game" />
                </Grid>
            </Border>

            <Border Style="{StaticResource ForgeCard}">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Grid Width="40" Height="40">
                            <Border CornerRadius="10" Background="{StaticResource ForgeEmberBrush}" />
                            <FontIcon Glyph="&#xE7FC;" FontSize="20" Foreground="{StaticResource ForgeAccentDeepBrush}" />
                        </Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="PadForge" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="{x:Bind ViewModel.Version}" Style="{StaticResource MutedBody}" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Style="{StaticResource MutedBody}" Text="Free and open source under the MIT License. PadForge does not inject into games. It creates a standard virtual Xbox 360 controller through ViGEmBus. Use it only in games that allow controller emulators." />
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <HyperlinkButton Content="Source on GitHub" NavigateUri="https://github.com/PrimeBuild-pc/PadForge" />
                        <HyperlinkButton Content="Report a problem" NavigateUri="https://github.com/PrimeBuild-pc/PadForge/issues" />
                        <HyperlinkButton Content="ViGEmBus driver" NavigateUri="https://github.com/nefarius/ViGEmBus/releases/latest" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
