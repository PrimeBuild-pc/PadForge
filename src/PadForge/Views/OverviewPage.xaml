<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="PadForge.Views.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:PadForge.Controls">
    <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1120" Padding="36,4,36,32" Spacing="18">
            <StackPanel Spacing="4">
                <TextBlock Text="Overview" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Your keyboard and mouse, as an Xbox or PlayStation controller. Free, with no account." Style="{StaticResource PageSubtitle}" />
            </StackPanel>


            <!-- Hero: state and the main action -->
            <Border Style="{StaticResource ForgeCard}" Padding="24">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="8" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Ellipse x:Name="HeroDot" Width="10" Height="10" Fill="{StaticResource ForgeSubtleBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.StatusTitle, Mode=OneWay}" FontFamily="{StaticResource ForgeDisplayFont}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource ForgeTextBrush}" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.StatusBody, Mode=OneWay}" Style="{StaticResource MutedBody}" MaxWidth="560" HorizontalAlignment="Left" />
                        <HyperlinkButton Content="Download ViGEmBus (official releases)" NavigateUri="https://github.com/nefarius/ViGEmBus/releases/latest" Padding="0,4" Visibility="{x:Bind ViewModel.ShowBusWarning, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Button Content="Center stick" Command="{x:Bind ViewModel.CenterStickCommand}" Style="{StaticResource ForgeSecondaryButton}" AutomationProperties.Name="Center the right stick" />
                        <Button Content="{x:Bind ViewModel.ActionLabel, Mode=OneWay}"
                                IsEnabled="{x:Bind ViewModel.ActionEnabled, Mode=OneWay}"
                                Command="{x:Bind ViewModel.ToggleOutputCommand}"
                                Style="{StaticResource ForgePrimaryButton}"
                                Padding="22,11"
                                AutomationProperties.Name="Connect or disconnect the virtual controller" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Live view -->
            <Border Style="{StaticResource ForgeCard}">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Live input" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="What the virtual pad receives. Try WASD, the mouse and your mapped keys." Style="{StaticResource MutedBody}" />
                        </StackPanel>
                        <TextBlock x:Name="Readout" Style="{StaticResource FieldValue}" VerticalAlignment="Top" Text="L +0.00 +0.00   R +0.00 +0.00" />
                    </Grid>
                    <Grid Grid.Row="1" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="8" VerticalAlignment="Center">
                            <controls:StickView x:Name="LeftGauge" />
                            <TextBlock Text="LEFT STICK" Style="{StaticResource SectionLabel}" HorizontalAlignment="Center" />
                            <Grid Height="6" CornerRadius="3" Background="{StaticResource ForgeWellBrush}" Margin="0,6,0,0">
                                <Border x:Name="LtFill" HorizontalAlignment="Left" Width="0" CornerRadius="3" Background="{StaticResource ForgeAccentBrush}" />
                            </Grid>
                            <TextBlock Text="LT" Style="{StaticResource SectionLabel}" HorizontalAlignment="Center" />
                        </StackPanel>
                        <Viewbox Grid.Column="1" MaxHeight="320" Stretch="Uniform">
                            <controls:PadRender x:Name="Pad" />
                        </Viewbox>
                        <StackPanel Grid.Column="2" Spacing="8" VerticalAlignment="Center">
                            <controls:StickView x:Name="RightGauge" />
                            <TextBlock Text="RIGHT STICK · MOUSE" Style="{StaticResource SectionLabel}" HorizontalAlignment="Center" />
                            <Grid Height="6" CornerRadius="3" Background="{StaticResource ForgeWellBrush}" Margin="0,6,0,0">
                                <Border x:Name="RtFill" HorizontalAlignment="Left" Width="0" CornerRadius="3" Background="{StaticResource ForgeAccentBrush}" />
                            </Grid>
                            <TextBlock Text="RT" Style="{StaticResource SectionLabel}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Grid ColumnSpacing="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource ForgeCard}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="6">
                            <TextBlock Text="Hide keys and clicks from the game" Style="{StaticResource CardTitle}" />
                            <TextBlock Style="{StaticResource MutedBody}" Text="While the controller is sending, mapped keys and clicks stop reaching Windows and the cursor stays still, so the game only sees the pad. Unmapped keys, Alt+Tab and the toggle key still work." />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.HideInput, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Top" AutomationProperties.Name="Hide mapped keys and clicks from the game" />
                    </Grid>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource ForgeCard}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Quick start" Style="{StaticResource CardTitle}" />
                        <Grid ColumnSpacing="10" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="1" Foreground="{StaticResource ForgeAccentBrush}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Style="{StaticResource MutedBody}" Text="Connect the controller here or with the toggle key." />
                            <TextBlock Grid.Row="1" Text="2" Foreground="{StaticResource ForgeAccentBrush}" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource MutedBody}" Text="Switch to the game. Output pauses whenever PadForge is in front." />
                            <TextBlock Grid.Row="2" Text="3" Foreground="{StaticResource ForgeAccentBrush}" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource MutedBody}" Text="Tune aim on Aim &amp; sticks, then save the profile." />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
