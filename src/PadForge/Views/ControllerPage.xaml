<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="PadForge.Views.ControllerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1120" Padding="36,4,36,32" Spacing="18">
            <StackPanel Spacing="4">
                <TextBlock Text="Controller" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Choose which controller games see. Switching while connected recreates the virtual pad as the new type." Style="{StaticResource PageSubtitle}" />
            </StackPanel>

            <Grid ColumnSpacing="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button x:Name="XboxCard" Click="Xbox_Click" Style="{StaticResource CalloutButton}" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" CornerRadius="12" AutomationProperties.Name="Emulate an Xbox 360 controller">
                    <StackPanel>
                        <Image Source="ms-appx:///Assets/Pads/xbox360.png" Height="230" Stretch="UniformToFill" Margin="0,8,0,0" />
                        <StackPanel Padding="20,4,20,20" Spacing="6">
                            <Grid>
                                <TextBlock Text="Xbox 360 controller" Style="{StaticResource CardTitle}" />
                                <Border x:Name="XboxChip" HorizontalAlignment="Right" CornerRadius="999" Padding="10,3" Background="{StaticResource ForgeAccentSoftBrush}">
                                    <TextBlock Text="Selected" FontSize="12" Foreground="{StaticResource ForgeAccentBrush}" />
                                </Border>
                            </Grid>
                            <TextBlock Style="{StaticResource MutedBody}" Text="XInput. Works with almost every PC game, Steam and Game Pass titles. The safe default." />
                        </StackPanel>
                    </StackPanel>
                </Button>

                <Button x:Name="Ds4Card" Grid.Column="1" Click="Ds4_Click" Style="{StaticResource CalloutButton}" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" CornerRadius="12" AutomationProperties.Name="Emulate a DualShock 4 controller">
                    <StackPanel>
                        <Image Source="ms-appx:///Assets/Pads/dualshock4.png" Height="230" Stretch="UniformToFill" Margin="0,8,0,0" />
                        <StackPanel Padding="20,4,20,20" Spacing="6">
                            <Grid>
                                <TextBlock Text="DualShock 4 (PS4)" Style="{StaticResource CardTitle}" />
                                <Border x:Name="Ds4Chip" HorizontalAlignment="Right" CornerRadius="999" Padding="10,3" Background="{StaticResource ForgeAccentSoftBrush}">
                                    <TextBlock Text="Selected" FontSize="12" Foreground="{StaticResource ForgeAccentBrush}" />
                                </Border>
                            </Grid>
                            <TextBlock Style="{StaticResource MutedBody}" Text="For games that show PlayStation prompts or only read PlayStation pads. In Steam, turn on PlayStation configuration support if a game ignores it." />
                        </StackPanel>
                    </StackPanel>
                </Button>
            </Grid>

            <Border Style="{StaticResource ForgeCard}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <Ellipse x:Name="BusDot" Width="9" Height="9" Fill="{StaticResource ForgeSubtleBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.BusHeadline, Mode=OneWay}" Style="{StaticResource CardTitle}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource MutedBody}" Text="ViGEmBus is the driver that creates the virtual pad. Windows sees a standard wired controller; PadForge never touches the game itself." />
                        <TextBlock Style="{StaticResource MutedBody}" Text="DualSense (PS5) is not offered: ViGEmBus can only emulate Xbox 360 and DualShock 4 pads. Most PS5-era PC games accept a DualShock 4." />
                    </StackPanel>
                    <HyperlinkButton Grid.Column="1" Content="Get ViGEmBus" NavigateUri="https://github.com/nefarius/ViGEmBus/releases/latest" VerticalAlignment="Top" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
